{
	"version": "2.0.0",
	"tasks": [							
		{
			"label": "example: construct (term)",
			"type": "cargo",
			"command": "run",
			"args": [
				"--example",
				"construct",
				"--features=term,vm,dom,ninepatch"
			],
			"env": {
				"RUST_BACKTRACE": "1",
				"NODEM_ARCH": "EXAMPLE"
			},
			"problemMatcher": [
				"$rustc"
			]
		},
